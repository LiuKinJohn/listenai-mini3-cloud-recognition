
#
# LISTENAI SDK
#

#
# SDK System Configuration
#
CONFIG_ARCS_STARTUP_CONFIG=y
CONFIG_MAIN_TASK_STACK_SIZE=2048
CONFIG_MAIN_TASK_PRIORITY=1
CONFIG_BANNER=y
# CONFIG_BOOT is not set
# CONFIG_PRINTF_LOG_REDIRECT is not set

#
# System Initialization
#
CONFIG_SYS_INIT=y
# CONFIG_SYS_INIT_DEBUG is not set
# end of System Initialization

#
# Console
#
CONFIG_CONSOLE=y

#
# Console UART Backend
#
CONFIG_CONSOLE_UART_BACKEND=y
CONFIG_CONSOLE_UART_BAUDRATE=921600
CONFIG_CONSOLE_UART_NAME="uart0"
CONFIG_CONSOLE_UART0_SELECT=y
CONFIG_CONSOLE_UART_EARLY_INIT=y
# end of Console UART Backend
# end of Console

#
# Exception & Backtrace
#
CONFIG_BACK_TRACE=y
# CONFIG_EXCEPTION_REBOOT_IMMEDIATELY is not set
# end of Exception & Backtrace

#
# C++ Support
#
CONFIG_LINK_CPP_RUNTIME_SECTIONS=y
# CONFIG_CPP_INIT_DEFERRED is not set
CONFIG_CPP_EXCEPTIONS=y
# end of C++ Support

CONFIG_RINGBUF=y

#
# heap
#
CONFIG_HEAP=y
CONFIG_HEAP_SIZE=0x4800
CONFIG_PSRAM_HEAP=y
CONFIG_PSRAM_HEAP_SIZE=0x370000
# CONFIG_PSRAM_NOCACHE_HEAP is not set
# end of heap

#
# work_queue
#
# CONFIG_WORK_QUEUE is not set
# end of work_queue

#
# log configuration
#
CONFIG_LOG=y
CONFIG_LOG_FRONTEND_EASYLOGGER=y
CONFIG_LOG_BACKEND_CONSOLE=y
# CONFIG_SOC_EARLY_LOG is not set
# CONFIG_LOG_BACKEND_IPC_WRITER is not set
# CONFIG_LOG_BACKEND_IPC_READER is not set
# CONFIG_LOG_BACKEND_SEGGER_RTT is not set
CONFIG_LOG_MODE_ASYNC=y
CONFIG_LOG_ASYNC_BUF_SIZE=10240
CONFIG_LOG_ASYNC_TASK_STACK_SIZE=512
CONFIG_LOG_ASYNC_TASK_PRIORITY=1
CONFIG_LOG_LINE_BUF_SIZE=1024
# CONFIG_LOG_USE_POSIX_TIME is not set
CONFIG_LOG_BACKEND_SYS_NAME="sys.log"
# CONFIG_LOG_LEVEL_ASSERT is not set
# CONFIG_LOG_LEVEL_ERROR is not set
# CONFIG_LOG_LEVEL_WARN is not set
CONFIG_LOG_LEVEL_INFO=y
# CONFIG_LOG_LEVEL_DEBUG is not set
# CONFIG_LOG_LEVEL_VERBOSE is not set
# end of log configuration

CONFIG_LISA_OS=y
CONFIG_BOOT_AP_ENTRY=0
# CONFIG_BOOT_FACTORY_PARAMS is not set
# CONFIG_BOOT_SECOND_STAGE is not set
# CONFIG_BOOT_DISPLAY is not set
# CONFIG_BOOT_ADB is not set
# CONFIG_BOOT_ADB_SYNC is not set
CONFIG_ADB_SHELL=y
# CONFIG_ADB_SYNC is not set
CONFIG_TINY_USB_CONFIG_FILE="tusb_config.h"
CONFIG_SDK_MODULE_LETTER_SHELL=y
CONFIG_SDK_MODULE_LETTER_SHELL_CONFIG_FILE="shell_cfg_user.h"
# CONFIG_BOOT_DUAL_FLASH is not set
CONFIG_BOOT_FLASH_SIZE=0x2000
CONFIG_BOOT_LOG_LVL_NON=y
# CONFIG_BOOT_LOG_LVL_ERR is not set
# CONFIG_BOOT_LOG_LVL_WRN is not set
# CONFIG_BOOT_LOG_LVL_INF is not set
# CONFIG_BOOT_LOG_LVL_DBG is not set
CONFIG_BOOT_LOG=y
# CONFIG_BOOT_EARLY_LOG is not set
CONFIG_BOOT_UART_PORT=0
CONFIG_BOOT_UART_TX_PIN=3
CONFIG_BOOT_UART_BAUDRATE=921600
CONFIG_BOOT_UART_PIN_FUNC_SEL=2
# CONFIG_BOOT_CHECK_GPIO is not set
# CONFIG_BOOT_CHECK_POWER_KEY is not set
# CONFIG_BOOT_POWER_GUARD is not set
# CONFIG_BOOT_RECOVERY is not set
# CONFIG_BOOT_RECOVERY_API is not set
# CONFIG_BOOT_WDT_API is not set
CONFIG_BOOT_POWER_API=y
# CONFIG_BOOT_FEATURES is not set
CONFIG_BOOT_FEATURES_ADDR=0x30000180
CONFIG_BOOT_FEATURES_API=y
# CONFIG_BOOT_EARLY_INIT is not set
# CONFIG_BOOT_OTA_PACKAGE is not set
CONFIG_BOOT_OTA_API=y
# CONFIG_BOOT_CONTROL_STORE_NONE is not set
CONFIG_BOOT_CONTROL_STORE_FLASH=y
# CONFIG_BOOT_CONTROL_STORE_TEST is not set
CONFIG_BOOT_CONTROL_STORE_BASE_ADDR=0x3003E000
CONFIG_BOOT_CONTROL_STORE_SIZE=4096
# CONFIG_BOOT_WDT is not set
# CONFIG_BOOT_VADDR_REMAP is not set
# end of SDK System Configuration

CONFIG_SOC_ARCS=y
# CONFIG_SOC_HAS_NPU is not set
CONFIG_MEM_CONFIG=y

#
# Memory Layout
#
CONFIG_MEM_INTERRUPT_STACK_SIZE=0x1000
CONFIG_MEM_HEAP_SIZE=512

#
# SRAM
#
CONFIG_MEM_SRAM_BASE=0x20016000
CONFIG_MEM_SRAM_SIZE=0x2A000
# end of SRAM

#
# PSRAM
#
CONFIG_MEM_PSRAM_BASE=0x28300000
CONFIG_MEM_PSRAM_SIZE=0x500000
# end of PSRAM

#
# Flash
#
CONFIG_MEM_FLASH_BASE=0x30600000
CONFIG_MEM_FLASH_SIZE=0x00800000
# end of Flash

#
# Local Memory (TCM)
#
CONFIG_MEM_ILM_BASE=0x00280000
CONFIG_MEM_ILM_SIZE=0x00004000
CONFIG_MEM_DLM_BASE=0x00300000
CONFIG_MEM_DLM_SIZE=0x00002000
# end of Local Memory (TCM)

#
# LUNA RAM
#
CONFIG_MEM_LUNA_BASE=0x200B0000
CONFIG_MEM_LUNA_SIZE=0x00006000
CONFIG_MEM_LUNA_SHARED_BASE=0x20042000
CONFIG_MEM_LUNA_SHARED_SIZE=0x00007000
# end of LUNA RAM

#
# Bluetooth RAM
#
CONFIG_MEM_BTRAM_BASE=0x200C0000
CONFIG_MEM_BTRAM_SIZE=0x00006000
# end of Bluetooth RAM

#
# IPC Shared Memory
#
CONFIG_MEM_IPC_ISOLATED=y
CONFIG_MEM_IPC_BASE=0x20040000
CONFIG_MEM_IPC_SIZE=0x00002000
# end of IPC Shared Memory

#
# Algorithm RAM
#
CONFIG_MEM_APRAM_BASE=0x20058800
CONFIG_MEM_APRAM_SIZE=0x00057800
# end of Algorithm RAM

#
# WiFi Memory
#
CONFIG_MEM_WFRAM_BASE=0x20000000
CONFIG_MEM_WFRAM_SIZE=0x16000
CONFIG_MEM_WIFI_CALIBRATION_SIZE=0x4000
CONFIG_MEM_WIFI_TRACE_SIZE=0x0000
# end of WiFi Memory
# end of Memory Layout

